# ---------------------------------------------------------------------------
# App (Expo) — vão para o navegador/celular, então NUNCA coloque segredos aqui
# ---------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Endereço do site publicado. Só o app de celular usa (na web a API é do mesmo domínio).
EXPO_PUBLIC_SITE_URL=https://seu-projeto.vercel.app

# ---------------------------------------------------------------------------
# Servidor (funções da Vercel em api/) — segredos, configure SÓ no painel da Vercel
# Sem prefixo EXPO_PUBLIC_: assim eles nunca entram no código do app.
# ---------------------------------------------------------------------------

# Conta de serviço do Firebase (Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gmail que envia o código. SMTP_PASS é uma SENHA DE APP de 16 letras, não a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ElaSegura <mesmo-gmail@gmail.com>

# Segredo que assina os códigos de 6 dígitos. Use um valor DIFERENTE do outro projeto.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RESET_CODE_SECRET=
